APP_NAME=ScriptFlow AI
DATABASE_PATH=data/scriptflow.sqlite3
OUTPUT_DIR=data/jobs
MAX_UPLOAD_BYTES=52428800
MAX_AUDIO_SECONDS=900
MOCK_PROCESSING_DELAY_SECONDS=0.05
FOOTAGE_PROVIDER=pixabay
PIXABAY_API_KEY=
PIXABAY_MIN_WIDTH=1280
PIXABAY_MIN_HEIGHT=720
PIXABAY_SAFE_SEARCH=true
PIXABAY_SEARCH_CACHE_SECONDS=86400
PIXABAY_REQUEST_RETRIES=1
TTS_PROVIDER=mock
TTS_API_KEY=
STT_PROVIDER=mock
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
REAL_RENDERING=false
